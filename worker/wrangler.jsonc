{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "pdf-insight-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },

  // Wartości jawne. Klucz API ustawiany wyłącznie jako sekret: `npx wrangler secret put LLM_API_KEY`
  "vars": {
    "ALLOWED_ORIGINS": "https://cherrox93.github.io",
    "LLM_BASE_URL": "https://api.deepseek.com",
    "LLM_MODEL": "deepseek-flash",
    "LLM_DISABLE_THINKING": "true",
    "DAILY_LIMIT": "300",
  },

  // Limit żądań: 10 analiz na minutę na adres IP.
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 },
    },
  ],

  // Globalny dzienny licznik analiz (ochrona salda API).
  "durable_objects": {
    "bindings": [{ "name": "USAGE", "class_name": "UsageCounter" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["UsageCounter"] }],
}
